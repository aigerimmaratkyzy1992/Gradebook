# Локалды Postgres. Neon сілтемесін сол күйінде қоюға болады —
# схема мен sslmode параметрі автоматты түрде asyncpg түріне келтіріледі.
DATABASE_URL=postgresql+asyncpg://gradebook:gradebook@localhost:5432/gradebook
SECRET_KEY=dev-secret-key-change-me-in-production-32b
DEBUG=true

# Frontend домендері (JSON тізім). Продта Netlify адресі жазылады.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Cloudflare R2 (S3 API). Бос болса — файлдар UPLOAD_DIR қалтасына жазылады (локалды даму).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# R2 бапталмағанда файлдар қалтасы.
UPLOAD_DIR=uploads


SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Осы пошталар admin рөлін алады (JSON тізім)
ADMIN_EMAILS=[]

# Admin пароль сбросын жасағанда қойылатын стандартты пароль
DEFAULT_PASSWORD=Gradebook2026
